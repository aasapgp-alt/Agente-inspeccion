# Dominio sslip.io con SSL/HTTPS automático gratuito (Let's Encrypt)
157.151.18.150.sslip.io, 157-151-18-150.sslip.io {
    reverse_proxy backend:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Redirección obligatoria de HTTP (:80) a HTTPS para evitar tráfico en texto plano
:80 {
    redir https://157.151.18.150.sslip.io{uri} permanent
}
